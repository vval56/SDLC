digraph G {
  rankdir=TB; nodesep=0.3; ranksep=0.65;
  node [shape=plain, fontname="Helvetica", fontsize=12];
  edge [color="#334155", fontname="Helvetica", fontsize=11, arrowhead=crow, arrowtail=none, dir=both, arrowtail=tee];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>users</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>email (unique), password_hash,<br align="left"/>full_name, unp, bank_details,<br align="left"/>failed_logins, locked_until<br align="left"/></td></tr></table>>];
  clients [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>clients</b></td></tr><hr/><tr><td align="left">PK id, FK user_id<br align="left"/>name, contact_person, email,<br align="left"/>phone, unp, details, archived,<br align="left"/>reminders_enabled<br align="left"/></td></tr></table>>];
  projects [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>projects</b></td></tr><hr/><tr><td align="left">PK id, FK client_id<br align="left"/>title, description, status,<br align="left"/>pricing_type, budget, rate,<br align="left"/>currency, start_date, deadline<br align="left"/></td></tr></table>>];
  milestones [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>milestones</b></td></tr><hr/><tr><td align="left">PK id, FK project_id<br align="left"/>title, due_date, done<br align="left"/></td></tr></table>>];
  status_changes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>status_changes</b></td></tr><hr/><tr><td align="left">PK id, FK project_id<br align="left"/>from_status, to_status,<br align="left"/>changed_at, is_return<br align="left"/></td></tr></table>>];
  invoices [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>invoices</b></td></tr><hr/><tr><td align="left">PK id, FK project_id<br align="left"/>number (unique в пределах<br align="left"/>user + год), kind (REGULAR,<br align="left"/>ADVANCE), FK advance_id,<br align="left"/>issue_date, due_date, vat_rate,<br align="left"/>total, status, paid_at<br align="left"/></td></tr></table>>];
  invoice_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>invoice_items</b></td></tr><hr/><tr><td align="left">PK id, FK invoice_id<br align="left"/>name, quantity, unit, price<br align="left"/></td></tr></table>>];
  acts [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#e2e8f0"><b>acts</b></td></tr><hr/><tr><td align="left">PK id, FK project_id,<br align="left"/>FK invoice_id (0..1)<br align="left"/>number, act_date, total<br align="left"/></td></tr></table>>];
  counters [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#334155"><tr><td bgcolor="#fef9c3"><b>document_counters</b></td></tr><hr/><tr><td align="left">PK (user_id, doc_type, year)<br align="left"/>last_number<br align="left"/></td></tr></table>>];
  users -> clients; clients -> projects; projects -> milestones; projects -> status_changes; projects -> invoices; invoices -> invoice_items; projects -> acts;
  users -> counters [style=dashed];
}
